# ═══════════════════════════════════════════════════
# REQUIRED — App will not start without these
# ═══════════════════════════════════════════════════

DATABASE_URL=postgresql://user:password@localhost:5432/iridium

# Generate with: openssl rand -base64 32
# Or run: npm run setup  (auto-generates this)
BETTER_AUTH_SECRET=<min-32-char-secret>

BETTER_AUTH_URL=http://localhost:5173
VITE_BETTER_AUTH_BASE_URL=http://localhost:5173

# ═══════════════════════════════════════════════════
# REQUIRED — Transactional Email (Resend)
# Get key → https://resend.com/api-keys
# ═══════════════════════════════════════════════════

RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ═══════════════════════════════════════════════════
# OPTIONAL — AI Chat (Vercel AI SDK)
# Supports: openai, anthropic, google
# Set AI_PROVIDER + AI_MODEL + the matching API key
# Default provider is openai if not set
# ═══════════════════════════════════════════════════

AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini

# Set whichever key matches your provider:
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=        (npm install @ai-sdk/anthropic)
# GOOGLE_GENERATIVE_AI_API_KEY=  (npm install @ai-sdk/google)

# ═══════════════════════════════════════════════════
# OPTIONAL — OAuth Providers
# GitHub → https://github.com/settings/developers
# Google → https://console.cloud.google.com/apis/credentials
# ═══════════════════════════════════════════════════

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ═══════════════════════════════════════════════════
# OPTIONAL — File Storage (Railway S3 / AWS S3)
# Railway S3 → Add Object Storage plugin in Railway dashboard
# AWS S3 → https://s3.console.aws.amazon.com/
# ═══════════════════════════════════════════════════

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_ENDPOINT_URL=https://storage.railway.app
AWS_DEFAULT_REGION=auto
AWS_FORCE_PATH_STYLE=false

# ═══════════════════════════════════════════════════
# APP PREFERENCES
# ═══════════════════════════════════════════════════

DEFAULT_THEME=light
ADMIN_EMAIL=
